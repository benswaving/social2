# Bezwaren-agent ASC — configuratie. Alle sleutels hebben het prefix OA_.

# --- LLM ---------------------------------------------------------------
# Zonder sleutel draait de agent op regels en sjablonen: bruikbaar om te testen,
# niet om productie op te draaien.
OA_OPENAI_API_KEY=
OA_OPENAI_MODEL=gpt-4o
# Alternatief:
# OA_LLM_PROVIDER=anthropic
# OA_ANTHROPIC_API_KEY=
# OA_ANTHROPIC_MODEL=claude-sonnet-5

# --- Opslag ------------------------------------------------------------
# SQLite is prima om mee te beginnen; voor meerdere medewerkers tegelijk Postgres.
# OA_DATABASE_URL=postgresql+psycopg://user:wachtwoord@localhost:5432/bezwaren

# --- Gedeelde postbus (IMAP) ------------------------------------------
# Gebruik een apart serviceaccount met alleen leesrechten op deze map.
OA_IMAP_HOST=
OA_IMAP_PORT=993
OA_IMAP_USER=
OA_IMAP_PASSWORD=
OA_IMAP_FOLDER=INBOX
OA_IMAP_PROCESSED_FOLDER=Verwerkt
OA_IMAP_MAX_PER_RUN=50

# --- Toegang -----------------------------------------------------------
# De applicatie start NIET zonder een van beide. Zet dit achter jullie SSO zodra
# dat kan; dit is de ondergrens, geen eindoplossing.
OA_UI_USER=asc
OA_UI_PASSWORD=
OA_AUTH_TOKEN=
# Alleen voor een lokale demo op een afgeschermde machine:
# OA_REQUIRE_AUTH=false

# --- Bewaartermijn -----------------------------------------------------
# Afgehandelde dossiers ouder dan dit aantal dagen mogen worden opgeruimd met
# `python -m app.retentie --uitvoeren`. Stem af met de FG. 0 = niet opruimen.
OA_BEWAARTERMIJN_DAGEN=730

# --- Beleid ------------------------------------------------------------
# Alleen geverifieerde bronnen mogen in een uitgaande brief worden geciteerd.
OA_REQUIRE_VERIFIED_SOURCES=true
# Bij deze score of hoger gaat een dossier altijd naar een medewerker.
OA_ESCALATION_THRESHOLD=0.35
